# Shakambari AI Environment Configuration
# Copy this file to backend/.env and customize as needed. Never commit real secrets.

APP_ENV=development

# Database: SQLite works out of the box for development.
# For production PostgreSQL / Supabase / Render Postgres use:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/shakambari
DATABASE_URL=sqlite:///./shakambari.db

# In production, SECRET_KEY must be >= 32 chars and not a known placeholder.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-shakambari-secret-key-32chars-minimum-length

# Authentication & Session
ACCESS_TOKEN_MINUTES=480
LOGIN_OTP_ENABLED=true
# When DEV_LOG_OTP=true and APP_ENV=development, OTPs are printed to the console for testing without SMTP
DEV_LOG_OTP=true

# Security & Proxies (Render, Vercel, Nginx)
TRUST_PROXY=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TIMEZONE=Asia/Kolkata

# File Storage & Artifacts
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MODEL_DIR=model_store
MAX_UPLOAD_MB=5

# Rate Limiting: memory | db | redis
RATE_LIMIT_BACKEND=memory
# REDIS_URL=redis://localhost:6379/0

# Email Delivery (SMTP / Gmail App Password, Resend, or Brevo)
# For Gmail: enable 2FA -> Generate App Password (16 characters)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Shakambari AI
MAIL_FROM_ADDRESS=noreply@shakambari.demo
# Optional alternative HTTPS API email provider (e.g. Resend)
# RESEND_API_KEY=

# Vision Classifier: heuristic | llm
VISION_PROVIDER=heuristic
# Multimodal LLM API Key (when VISION_PROVIDER=llm):
VISION_API_KEY=
VISION_MODEL=gemini-1.5-flash

# Background Scheduler & Startup
SCHEDULER_ENABLED=false
SEED_DEMO_ON_EMPTY=true
SEED_DEMO_PASSWORD=Demo@12345
CO2E_PER_KG_FOOD=2.5
