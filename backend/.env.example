# Copy to .env and edit. Never commit real secrets.
APP_ENV=development
# SQLite works out of the box. For PostgreSQL / Supabase use e.g.:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=sqlite:///./platesense.db
# Generate a long random value:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TIMEZONE=Asia/Kolkata
UPLOAD_DIR=uploads
MODEL_DIR=model_store
MAX_UPLOAD_MB=5
# Dev only: returns the password-reset token in the API response (no email provider is configured)
DEBUG_RETURN_RESET_TOKEN=false
# Recompute alerts every 15 minutes in the background
SCHEDULER_ENABLED=false
# Adjustable estimate factor used by the sustainability dashboard
CO2E_PER_KG_FOOD=2.5
SEED_DEMO_PASSWORD=Demo@12345
